{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["@cloudflare/vitest-plugin/types"],
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./ui/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "tests/**/*.ts",
    "worker-configuration.d.ts",
    "vitest.config.ts",
    "ui/**/*.ts",
    "ui/**/*.tsx",
    "vite.config.ts",
    "mock/**/*.ts"
  ]
}
